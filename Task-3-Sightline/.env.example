# Copy this file to .env and fill in the blanks before running docker compose.

POSTGRES_USER=sightline
POSTGRES_PASSWORD=
POSTGRES_DB=sightlinedb

# The hostname "db" is the compose service name. Use localhost outside Docker.
DATABASE_URL=postgresql://sightline:CHANGE_ME@db:5432/sightlinedb

# Signs the session cookie. Generate with: openssl rand -hex 32
JWT_SECRET=

PORT=4002
